{
  "name": "rtx-spark-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4317 --strictPort",
    "build": "tsc -b && vite build && node scripts/write-release.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4318 --strictPort",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "model": "python3 scripts/build-model.py",
    "model:optimize": "node scripts/optimize-model.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.183.0",
    "@vitejs/plugin-react": "latest",
    "gltf-validator": "^2.0.0-dev.3.10",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
